require "dotenv"
require "shellwords"

LOCAL_APP_STORE_ENV = File.expand_path("~/.config/uneconly/app-store-connect.env")
Dotenv.load(LOCAL_APP_STORE_ENV) if File.file?(LOCAL_APP_STORE_ENV)
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "60"
ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] ||= "2"

default_platform(:ios)

PROJECT_ROOT = File.expand_path("../..", __dir__)
DEFAULT_IPA_DIRECTORY = File.join(PROJECT_ROOT, "build/ios/ipa")

platform :ios do
  private_lane :app_store_api_key_options do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"]

    missing = []
    missing << "APP_STORE_CONNECT_API_KEY_ID" if key_id.to_s.empty?
    missing << "APP_STORE_CONNECT_API_KEY_PATH" if key_path.to_s.empty?

    unless missing.empty?
      UI.user_error!(
        "Missing #{missing.join(', ')}. See ios/fastlane/TESTFLIGHT.md for setup instructions."
      )
    end

    expanded_key_path = File.expand_path(key_path)
    UI.user_error!("App Store Connect API key not found: #{expanded_key_path}") unless File.file?(expanded_key_path)

    key_options = {
      key_id: key_id,
      key_filepath: expanded_key_path,
      duration: 1_200,
      in_house: false,
    }
    key_options[:issuer_id] = issuer_id unless issuer_id.to_s.empty?

    key_options
  end

  private_lane :app_store_api_key do
    app_store_connect_api_key(**app_store_api_key_options)
  end

  private_lane :xcode_api_key_arguments do
    key_options = app_store_api_key_options
    issuer_id = key_options[:issuer_id]

    if issuer_id.to_s.empty?
      UI.user_error!("APP_STORE_CONNECT_API_ISSUER_ID is required to automate Xcode signing with a team key")
    end

    Shellwords.join(
      [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath",
        key_options[:key_filepath],
        "-authenticationKeyID",
        key_options[:key_id],
        "-authenticationKeyIssuerID",
        issuer_id,
      ]
    )
  end

  private_lane :flutter_version_xcode_arguments do
    generated_config = File.join(PROJECT_ROOT, "ios/Flutter/Generated.xcconfig")
    UI.user_error!("Flutter build configuration not found: #{generated_config}") unless File.file?(generated_config)

    settings = File.readlines(generated_config, chomp: true).filter_map do |line|
      key, value = line.split("=", 2)
      [key, value] if ["FLUTTER_BUILD_NAME", "FLUTTER_BUILD_NUMBER"].include?(key)
    end.to_h

    build_name = settings["FLUTTER_BUILD_NAME"]
    build_number = settings["FLUTTER_BUILD_NUMBER"]
    UI.user_error!("FLUTTER_BUILD_NAME is missing from #{generated_config}") if build_name.to_s.empty?
    UI.user_error!("FLUTTER_BUILD_NUMBER is missing from #{generated_config}") if build_number.to_s.empty?

    # Apply the Flutter version to every target, including the widget extension.
    # App Store Connect rejects archives whose extension build number differs
    # from the containing app's build number.
    Shellwords.join(
      [
        "MARKETING_VERSION=#{build_name}",
        "CURRENT_PROJECT_VERSION=#{build_number}",
      ]
    )
  end

  private_lane :resolve_ipa do |options|
    requested_path = options[:ipa] || ENV["IOS_IPA_PATH"]

    unless requested_path.to_s.empty?
      ipa_path = File.expand_path(requested_path, PROJECT_ROOT)
      UI.user_error!("IPA not found: #{ipa_path}") unless File.file?(ipa_path)
      next ipa_path
    end

    candidates = Dir[File.join(DEFAULT_IPA_DIRECTORY, "*.ipa")]
    UI.user_error!("No IPA found in #{DEFAULT_IPA_DIRECTORY}. Run the beta lane or pass ipa:/absolute/path.ipa") if candidates.empty?
    UI.user_error!("Multiple IPAs found in #{DEFAULT_IPA_DIRECTORY}; pass ipa:/absolute/path.ipa") if candidates.length > 1

    candidates.first
  end

  private_lane :upload_beta_build do |options|
    api_key = app_store_api_key
    ipa_path = resolve_ipa(ipa: options[:ipa])

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      submit_beta_review: false,
      notify_external_testers: false,
    )
  end

  private_lane :copy_live_review_information_to_edit_version do |options|
    app = Spaceship::ConnectAPI::App.find("com.roadmapik.uneconly")
    UI.user_error!("App not found in App Store Connect") unless app

    live_version = app
      .get_app_store_versions(filter: { platform: "IOS" })
      .select { |version| version.app_store_state == "READY_FOR_SALE" }
      .max_by { |version| Gem::Version.new(version.version_string) }
    UI.user_error!("No live iOS version found to copy review contact details from") unless live_version

    edit_version = app.get_edit_app_store_version(platform: "IOS")
    expected_version = options[:app_version].to_s
    unless edit_version&.version_string == expected_version
      UI.user_error!("Editable iOS version #{expected_version} was not found")
    end

    source = live_version.fetch_app_store_review_detail
    UI.user_error!("The live version has no App Review contact details") unless source

    attributes = {
      "contact_first_name" => source.contact_first_name,
      "contact_last_name" => source.contact_last_name,
      "contact_phone" => source.contact_phone,
      "contact_email" => source.contact_email,
      "demo_account_required" => false,
      "demo_account_name" => "",
      "demo_account_password" => "",
      "notes" => "No account is required. On first launch, select any group (for example, БИ-2604) to view its schedule. The Home Screen widget can be added from the system widget gallery after a group has been selected.",
    }

    target = begin
      edit_version.fetch_app_store_review_detail
    rescue
      nil
    end

    if target
      target.update(attributes: attributes)
    else
      edit_version.create_app_store_review_detail(attributes: attributes)
    end

    UI.success("Copied App Review contact details without storing them in the repository")
  end

  private_lane :select_processed_app_store_build do |options|
    app = Spaceship::ConnectAPI::App.find("com.roadmapik.uneconly")
    UI.user_error!("App not found in App Store Connect") unless app

    edit_version = app.get_edit_app_store_version(platform: "IOS")
    app_version = options[:app_version].to_s
    build_number = options[:build_number].to_s
    unless edit_version&.version_string == app_version
      UI.user_error!("Editable iOS version #{app_version} was not found")
    end

    build = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: app_version,
      build_number: build_number,
      platform: "IOS",
    ).first
    UI.user_error!("Build #{app_version}(#{build_number}) was not found") unless build
    unless build.processing_state == "VALID"
      UI.user_error!("Build #{app_version}(#{build_number}) is #{build.processing_state}, not VALID")
    end

    edit_version.select_build(build_id: build.id)
    UI.success("Selected processed build #{app_version}(#{build_number})")
  end

  private_lane :complete_age_rating_declaration do
    app = Spaceship::ConnectAPI::App.find("com.roadmapik.uneconly")
    UI.user_error!("App not found in App Store Connect") unless app

    app_info = app.fetch_edit_app_info || app.fetch_latest_app_info
    UI.user_error!("Editable App Information was not found") unless app_info

    declaration = app_info.fetch_age_rating_declaration
    UI.user_error!("Age rating declaration was not found") unless declaration

    # App Store Connect's 2026 questionnaire requires these newer attributes
    # even when the previously saved declaration has no applicable content.
    declaration.update(
      attributes: {
        "guns_or_other_weapons" => "NONE",
        "user_generated_content" => false,
        "health_or_wellness_topics" => false,
        "advertising" => false,
        "loot_box" => false,
        "parental_controls" => false,
        "age_assurance" => false,
        "messaging_and_chat" => false,
        "social_media" => false,
        "social_media_age_restricted" => false,
      },
    )

    UI.success("Completed the required age-rating questionnaire fields")
  end

  private_lane :build_beta_ipa do |options|
    flutter_command = ["flutter", "build", "ios", "--config-only", "--release"]
    flutter_command += ["--build-name", options[:build_name]] unless options[:build_name].to_s.empty?
    flutter_command += ["--build-number", options[:build_number]] unless options[:build_number].to_s.empty?

    Dir.chdir(PROJECT_ROOT) do
      sh(*flutter_command)
    end

    build_arguments = [xcode_api_key_arguments, flutter_version_xcode_arguments].join(" ")

    build_app(
      workspace: File.join(PROJECT_ROOT, "ios/Runner.xcworkspace"),
      scheme: "Runner",
      configuration: "Release",
      archive_path: File.join(PROJECT_ROOT, "build/ios/archive/Runner.xcarchive"),
      output_directory: DEFAULT_IPA_DIRECTORY,
      output_name: "uneconly.ipa",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: "XQZ47WXYMB",
        manageAppVersionAndBuildNumber: false,
      },
      skip_package_dependencies_resolution: true,
      # gym also reuses xcargs during export, so passing the same values via
      # export_xcargs would duplicate xcodebuild's authentication flags.
      xcargs: build_arguments,
    )
  end

  desc "Build a signed App Store Connect IPA without uploading it"
  lane :build_beta do |options|
    build_beta_ipa(options)
  end

  desc "Build a release IPA and upload it to App Store Connect for TestFlight"
  lane :beta do |options|
    upload_beta_build(ipa: build_beta_ipa(options))
  end

  desc "Upload an existing IPA to App Store Connect for TestFlight"
  lane :upload_beta do |options|
    upload_beta_build(ipa: options[:ipa])
  end

  desc "Verify App Store Connect API access without uploading anything"
  lane :verify_app_store_connection do
    latest_testflight_build_number(api_key: app_store_api_key)
  end

  desc "Create or update App Store version 2.0.0, metadata, screenshots, and build selection"
  lane :prepare_app_store_release do |options|
    app_version = options[:app_version] || "2.0.0"
    build_number = options[:build_number] || "59"
    api_key = app_store_api_key

    upload_to_app_store(
      api_key: api_key,
      app_identifier: "com.roadmapik.uneconly",
      app_version: app_version,
      build_number: build_number,
      platform: "ios",
      metadata_path: File.join(PROJECT_ROOT, "ios/fastlane/metadata"),
      screenshots_path: File.join(PROJECT_ROOT, "ios/fastlane/screenshots"),
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
    )

    copy_live_review_information_to_edit_version(app_version: app_version)
    select_processed_app_store_build(app_version: app_version, build_number: build_number)
  end

  desc "Submit the prepared App Store version for review and release automatically after approval"
  lane :submit_app_store_release do |options|
    app_version = options[:app_version] || "2.0.0"
    build_number = options[:build_number] || "59"
    api_key = app_store_api_key

    copy_live_review_information_to_edit_version(app_version: app_version)
    complete_age_rating_declaration

    upload_to_app_store(
      api_key: api_key,
      app_identifier: "com.roadmapik.uneconly",
      app_version: app_version,
      build_number: build_number,
      platform: "ios",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      # Fastlane 2.239 forwards both the API key object and its key path to
      # Precheck, which rejects that otherwise valid combination as conflicting.
      # The lane's release-card verification is performed separately before
      # submission, so keep Deliver's duplicate Precheck disabled here.
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
      },
    )
  end
end
